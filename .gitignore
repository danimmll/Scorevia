# ==========================================
# 🛑 SEGURIDAD, SECRETOS Y ENTORNO (CRÍTICO)
# ==========================================
# Archivos de configuración local y credenciales de producción
.env
.env.*
!.env.example
*.pem
*.key
*.jwt
secrets/
credentials/

**/.claude/settings.local.json

**/jenkins_home_backup/

# Bloquear volcados de bases de datos que contengan datos reales
*.sql
!init.sql
*.sql.gz

# ==========================================
# ☕ JAVA, MAVEN & MICROSERVICIOS
# ==========================================
# Carpetas de compilación de todos tus microservicios (Estadísticas, Predicciones, etc.)
**/target/
**/*.class
**/*.jar
**/*.war
**/*.ear

# Empaquetados del wrapper de Maven para que no saturen Git
**/.mvn/wrapper/maven-wrapper.jar

# Logs de las aplicaciones Spring Boot
**/*.log
**/microservices_logs/
**/logs/

# Crash dumps de la máquina virtual de Java
hs_err_pid*
replay_pid*

# ==========================================
# 🅰️ ANGULAR & NODE.JS (FRONTEND)
# ==========================================
# Dependencias locales de Node
**/node_modules/
**/.angular/cache/

# Salidas de producción y compilación de Angular
**/dist/
**/tmp/
**/out-tsc/
**/bazel-out/
**/coverage/

# Logs de error disciplinarios de Node/NPM
npm-debug.log*
yarn-debug.log*
yarn-error.log*
eslintdebug.log*
testem.log

# Archivos de configuración de pruebas locales de Angular
/scorevia-frontend/__screenshots__/

# ==========================================
# 🐳 INFRAESTRUCTURA: DOCKER VOLUMES & LOGS
# ==========================================
# Persistencia local de datos de contenedores para que no se suban a GitHub
**/postgres_data/
**/jenkins_data/
**/sonarqube_data/
**/sonarqube_logs/
**/sonarqube_extensions/

# ==========================================
# 💻 ENTORNOS DE DESARROLLO (IDEs)
# ==========================================
# IntelliJ IDEA (Ficheros de workspace local que chocan entre compañeros)
.idea/
**/.idea/
*.iml
*.iws
*.ipr
**/out/

# Eclipse
.project
.classpath
.settings/
**/bin/

# Visual Studio Code (Excluimos configuraciones personales, dejamos las del equipo si hacen falta)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# Otros editores alternativos
.c9/
*.launch
*.sublime-workspace

# ==========================================
# 🍏 ARCHIVOS DE SISTEMA OPERATIVO
# ==========================================
# macOS
.DS_Store
.DS_Store?
._*
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# ==========================================
# PYTHON (scripts de ingesta)
# ==========================================
# Cache de bytecode: binario, se regenera solo y no se puede abrir con un editor.
__pycache__/
*.pyc
*.pyo

# Copias de seguridad de la base de datos (scripts/backup_db.py): son cientos de MB
# y contienen datos reales, no van al repositorio.
backups/
*.dump

