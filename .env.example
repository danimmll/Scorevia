# Copia este fichero a .env (en la raíz) para los scripts de Python de scripts/.
# Las variables de la base de datos se leen además de scorevia-backend/.env.

# API-Football v3
API_FOOTBALL_KEY=tu_api_key

# Usuario administrador de la propia app (los scripts piden un JWT al Gateway con él)
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=cambia_esto

# Gateway de ScoreVia
SCOREVIA_BASE_URL=http://localhost:8085

# Conexión directa a Postgres (puerto publicado por docker compose)
DB_HOST=127.0.0.1
DB_PORT=5433

# Peticiones diarias de API-Football que los scripts dejan sin tocar para el backend
SCRIPTS_RESERVA_API=25000
