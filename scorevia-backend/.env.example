# Copia este fichero a scorevia-backend/.env y rellena los valores.
# docker compose lo lee automáticamente. Nunca subas el .env real al repositorio.

# --- Base de datos (superusuario de Postgres, solo para administración e init.sql) ---
DB_NAME=futbol_stats
DB_USER=postgres
DB_PASS=cambia_esto

# --- Un rol de Postgres por microservicio (mínimo privilegio) ---
# init.sql los crea con contraseñas de ejemplo (PEGAR_AQUI_...): cámbialas con
# ALTER ROLE <rol> WITH PASSWORD '...'; y pon aquí las mismas.
USUARIOS_DB_USER=scorevia_usuarios
USUARIOS_DB_PASS=cambia_esto
INCIDENCIAS_DB_USER=scorevia_incidencias
INCIDENCIAS_DB_PASS=cambia_esto
ESTADISTICAS_DB_USER=scorevia_estadisticas
ESTADISTICAS_DB_PASS=cambia_esto

# --- Seguridad ---
# Clave HMAC para firmar los JWT: una cadena aleatoria de 64+ caracteres.
# Por ejemplo: openssl rand -base64 64 | tr -d '\n'
JWT_KEY=
# Secreto compartido entre microservicios (cabecera X-Internal-Secret que inyecta el Gateway).
# Por ejemplo: openssl rand -hex 32
INCIDENCIAS_INTERNAL_SECRET=
# Credenciales de Eureka (Basic Auth interno).
EUREKA_USERNAME=eureka
EUREKA_PASSWORD=cambia_esto
# true en producción (HTTPS); false en local.
COOKIE_SECURE=false
# Origen del frontend para CORS y cookies.
FRONTEND_ORIGIN=http://localhost:4000

# --- Servicios externos ---
# https://www.api-football.com/ (API-Football v3)
API_FOOTBALL_KEY=tu_api_key
# Login con Google (OAuth client ID del proyecto de Google Cloud)
GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
# Envío de correos de verificación (Gmail con contraseña de aplicación)
MAIL_USERNAME=tu_correo@gmail.com
MAIL_APP_PASSWORD=tu_password_de_aplicacion

# --- Trabajos automáticos de ingesta (true/false) ---
INGESTA_VIVO_HABILITADA=false
INGESTA_POST_PARTIDO_HABILITADA=false
INGESTA_RECOGIDA_HABILITADA=false
INGESTA_PLANTILLAS_HABILITADA=true
INGESTA_CALENDARIO_HABILITADA=false
INGESTA_CLASIFICACIONES_HABILITADA=false
INGESTA_RECONCILIACION_HABILITADA=false
INGESTA_PUESTA_AL_DIA_HABILITADA=true

# --- Solo producción / infraestructura ---
# Dominio que acepta el SSR de Angular (en local se deja vacío).
NG_ALLOWED_HOSTS=
# Correo para avisos de Let's Encrypt (Caddy).
ACME_EMAIL=
# Jenkins y SonarQube (docker-compose.infra.yml).
JENKINS_AGENT_SECRET=
SONARQUBE_DB_PASS=
